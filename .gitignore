# direnv
.direnv

# Environment variables
.env

# Ignore Gradle project-specific cache directory
.gradle

# Ignore Gradle build output directory
build

# Ignore Kotlin IDE files
.kotlin/

# Normalize
.normalize/*
!.normalize/config.toml
!.normalize/memory/

# VitePress docs site
docs/node_modules
docs/.vitepress/dist
docs/.vitepress/cache

# jqwik's local database of failing-sample seeds (BunFuzzTest.kt) — a per-machine cache
# for reproducing previous fuzz failures across runs, not something to version.
.jqwik-database
